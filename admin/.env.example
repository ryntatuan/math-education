# Sao chép file này thành .env.local rồi điền giá trị thật.
# Lấy trong Supabase Dashboard -> Project Settings -> API.
#
# ⚠️ CHỈ dùng anon key. KHÔNG BAO GIỜ đặt service_role key ở đây.
#    service_role bỏ qua toàn bộ RLS — nhúng vào frontend là mất hết bảo mật.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
